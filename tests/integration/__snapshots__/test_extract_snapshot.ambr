              111.3,
              188.4,
              500.4,
              198.4,
            ]),
            'id': 'p7_b005',
            'order': 5,
            'text': 'Table 2: Architecture hyperparameters for Open-Sora 2.0 11B parameter video generation model.',
            'type': 'text',
          }),
          dict({
            'bbox': list([
              108.0,
              227.9,
              205.8,
              239.9,
            ]),
            'id': 'p7_b006',
            'order': 6,
            'text': '''
              4
              Model Training
            ''',
            'type': 'text',
          }),
          dict({
            'bbox': list([
              107.6,
              252.1,
              504.3,
              316.6,
            ]),
            'id': 'p7_b007',
            'order': 7,
            'text': '''
              A commercial-grade video generation model typically requires more than 10 billion parameters and
              O(100M) training samples. To mitigate the substantial computational cost associated with training, we
              propose a cost-effective training pipeline, as outlined in Table 3. Our approach consists of three key
              stages: (1) training a text-to-video model on low-resolution video data, (2) training an image-to-video
              model on low-resolution video data, and (3) fine-tuning an image-to-video model on high-resolution
              videos.
            ''',
            'type': 'text',
          }),
          dict({
            'bbox': list([
              146.3,
              329.1,
              463.2,
              339.7,
            ]),
            'id': 'p7_b008',
            'order': 8,
            'text': '''
              Training Stage
              Dataset
              CP
              #iters
              #GPUs
              #GPU day
              USD
            ''',
            'type': 'text',
          }),
          dict({
            'bbox': list([
