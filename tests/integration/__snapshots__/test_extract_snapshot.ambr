              136.5,
            ]),
            'id': 'p3_b005',
            'order': 5,
            'text': 'Video Clips',
            'type': 'text',
          }),
          dict({
            'bbox': list([
              121.5,
              141.3,
              168.2,
              150.5,
            ]),
            'id': 'p3_b006',
            'order': 6,
