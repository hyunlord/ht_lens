# ht_lens — environment template
# Phase 6e: LLM routing split. Translate-path and chat-path clients are
# now built independently. The defaults below point both at the same
# sglang qwen3.6-27b instance (current prod) — swap independently by
# changing only TRANSLATE_LLM_* or CHAT_LLM_*.

# ─────────────────────────────────────────────────────────────────────
# Translate LLM — used by translate_document (block-level) +
# retranslate endpoint + translate CLI.
# Defaults: max_tokens=2048 (Phase E1 measured MAX=1513 token + 35% margin),
# temperature=0.0 (factual / deterministic).
# ─────────────────────────────────────────────────────────────────────
TRANSLATE_LLM_PROVIDER=openai_compat
TRANSLATE_LLM_BASE_URL=http://localhost:8081/v1
TRANSLATE_LLM_MODEL=qwen3.6-27b
TRANSLATE_LLM_API_KEY=EMPTY
TRANSLATE_LLM_MAX_TOKENS=2048
TRANSLATE_LLM_TEMPERATURE=0.0
TRANSLATE_LLM_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────
# Chat LLM — used by /threads/{id}/explain, /messages,
# /documents/{id}/summarize, and process_upload_job's summarize stage.
# Defaults: max_tokens=4096 (Q&A / summaries can be longer),
# temperature=0.2 (slight diversity for natural Korean phrasing).
# ─────────────────────────────────────────────────────────────────────
CHAT_LLM_PROVIDER=openai_compat
CHAT_LLM_BASE_URL=http://localhost:8081/v1
CHAT_LLM_MODEL=qwen3.6-27b
CHAT_LLM_API_KEY=EMPTY
CHAT_LLM_MAX_TOKENS=4096
CHAT_LLM_TEMPERATURE=0.2
CHAT_LLM_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────
# Legacy fallback (Phase 2b vars). When the scoped TRANSLATE_LLM_* /
# CHAT_LLM_* keys are unset (or empty), the factories fall back to
# these — both clients share the same backend.
# ─────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:8081/v1
# LLM_MODEL=qwen3.6-27b
# LLM_API_KEY=EMPTY
# LLM_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────
# Other secrets (optional)
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# App
HT_LENS_LOG_LEVEL=INFO
